{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "web-design-gonzalo-costadoni.vercel.app"
        }
      ],
      "destination": "https://costadonistudio.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/Web%20Design%20-%20Gonzalo%20Costadoni.dc.html"
    },
    {
      "source": "/admin",
      "destination": "https://gc-panel-admin.vercel.app/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "https://gc-panel-admin.vercel.app/admin/index.html"
    },
    {
      "source": "/admin/:path+",
      "destination": "https://gc-panel-admin.vercel.app/admin/:path+"
    }
  ]
}
